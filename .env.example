# MathNova configuration — copy to .env and edit.
# Every mathematics module works without any of these set; only the
# AI assistant needs credentials.

# --- AI Mathematics Assistant -------------------------------------
# Optional. Every mathematics module works without it.
#
# Primary provider: Google Gemini free tier. Create a key at
# https://aistudio.google.com/apikey — no billing account required.
GEMINI_API_KEY=

# Which backend answers: auto (default) | gemini | local
# MATHNOVA_AI_PROVIDER=auto

# Gemini model (default: gemini-3.6-flash). Any model your key can
# reach works; list them with client.models.list().
# MATHNOVA_AI_MODEL=gemini-3.6-flash

# --- Optional local model (no API key, fully offline) -------------
# Run `ollama serve` and `ollama pull llama3.1`, then enable it.
# MATHNOVA_LOCAL_AI_ENABLED=0
# MATHNOVA_LOCAL_AI_URL=http://localhost:11434
# MATHNOVA_LOCAL_AI_MODEL=llama3.1

# Response ceiling and agentic-loop bounds
# MATHNOVA_ASSISTANT_MAX_TOKENS=16000
# MATHNOVA_ASSISTANT_MAX_TOOL_TURNS=8
# MATHNOVA_ASSISTANT_HISTORY_LIMIT=20

# How long the assistant may wait on its provider, in seconds.
# MATHNOVA_ASSISTANT_TIMEOUT=45

# --- Limits -------------------------------------------------------
# Every engine call runs in a short-lived child process under these
# bounds, so one pathological expression cannot hang or exhaust a
# worker. Raise the deadline only if genuine problems are being cut off.
# MATHNOVA_COMPUTE_TIMEOUT=30
# Memory per calculation, on top of what the worker already uses.
# MATHNOVA_COMPUTE_MEMORY_MB=1024
# MATHNOVA_MAX_REQUEST_BYTES=131072

# --- Server -------------------------------------------------------
# Comma-separated extra origins. Leave empty for same-origin only,
# which is all the bundled frontend needs — it is served by this same
# app. List exact origins; "*" is refused outside debug mode.
# MATHNOVA_CORS_ORIGINS=https://mathnova.example.com

# Verbose logging
# MATHNOVA_DEBUG=0

# Port (most platforms set this for you)
# PORT=8000
